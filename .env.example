# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=https://touristy.runasp.net

# PayPal Public Client ID (Safe for client-side SDK; NEVER put PayPal Client Secret here)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal Environment: sandbox | live
NEXT_PUBLIC_PAYPAL_ENV=sandbox

# Default Currency for PayPal Card Fields (overridden by backend order currency when present)
NEXT_PUBLIC_PAYPAL_CURRENCY=EUR
